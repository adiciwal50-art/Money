# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PORTAL_USERNAME / ADMIN_PORTAL_PASSCODE: Secret backend credentials required to unlock the admin panel.
ADMIN_PORTAL_USERNAME=
ADMIN_PORTAL_PASSCODE=

# DATA_ENCRYPTION_KEY: 32-byte hex or passphrase used by backend AES-256-GCM encryption for sensitive records.
DATA_ENCRYPTION_KEY=
